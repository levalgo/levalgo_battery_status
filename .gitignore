# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/

# Generated by the Flutter tooling on the first build. local.properties holds
# absolute SDK paths from whichever machine ran it, so it must never be
# committed; the rest are Gradle wrapper artifacts.
local.properties
**/gradlew
**/gradlew.bat
**/gradle-wrapper.jar
**/GeneratedPluginRegistrant.java
